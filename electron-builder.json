{
  "appId": "com.amman.billing",
  "productName": "Amman Billing & Accounting",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon-512.png",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon-512.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Amman Billing & Accounting",
    "uninstallDisplayName": "Amman Billing & Accounting",
    "deleteAppDataOnUninstall": false,
    "artifactName": "Amman-Billing-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Amman-Billing-${version}-portable.${ext}"
  }
}
